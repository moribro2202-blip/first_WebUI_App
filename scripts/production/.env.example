# 即PAT(IPAT)投票用の認証情報
# このファイルを .env にコピーして値を設定してください
#
# 運用手順:
#   1. cp .env.example .env
#   2. .env に認証情報を入力
#   3. py -3.12-32 scripts/production/ipat_voter.py --test  でログインテスト
#   4. py -3.12-32 scripts/production/realtime_runner.py     でペーパートレード
#   5. py -3.12-32 scripts/production/realtime_runner.py --live で実投票

# === 即PAT認証情報 ===
IPAT_SUBSCRIBER_ID=your_subscriber_id
IPAT_PIN=your_pin_number
IPAT_PARS=your_pars_number

# === 投票設定 ===
# 1レースあたりの投票額（100円単位）
BET_AMOUNT=100
# 1レースあたりの最大投票数（単勝のみなので通常1）
MAX_BET_PER_RACE=1
# 1日の最大損失額（この額を超えたら投票停止）
MAX_DAILY_LOSS=10000
